{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Swansea Harriers website preview",
		"description": "Installs the Swansea Harriers theme and Harriers Core plugin, then loads the club's fixtures, results, training groups, volunteers, records, pages and menus.",
		"author": "cleverly87"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Swansea Harriers",
				"blogdescription": "Athletic Club · Since 1962",
				"timezone_string": "Europe/London",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/cleverly87/swanseaharriers-preview/main/dist/harriers-core-plugin.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/cleverly87/swanseaharriers-preview/main/dist/swansea-harriers-theme.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; hs_seed_starter_content(); flush_rewrite_rules( false );"
		}
	]
}
